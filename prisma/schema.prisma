// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/**
 * models
 */
model Technology {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  desc            String
  desc_en         String
  hexColor        String  @map("hex_color")
  officialWebsite String  @map("official_website")
  logoUrl         String  @map("logo_url")
  isBackend       Boolean @map("is_backend")
  isFrontend      Boolean @default(false) @map("is_frontend")

  projects Project[]
  skills   Skill[]
}

model Project {
  id            Int             @id @default(autoincrement())
  name          String
  desc          String
  desc_en       String
  repositoryUrl String          @map("repository_url")
  deployUrl     String          @map("deploy_url")
  thumbnailUrl  String          @map("thumbnail_url")
  category      ProjectCategory @relation(fields: [fkCategoryId], references: [id], onDelete: Cascade)

  fkCategoryId Int
  technologies Technology[]
}

model Skill {
  id      Int    @id @default(autoincrement())
  name    String
  name_en String

  technologies Technology[]
}

model ProjectCategory {
  id      Int    @id @default(autoincrement())
  name    String
  name_en String

  project Project[]
}

model Message {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  senderName  String
  senderEmail String
  subject     String
  text        String
}
